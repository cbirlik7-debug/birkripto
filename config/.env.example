# API anahtarları şablonu.
# Kopyalayın ve dosyayı `.env` olarak adlandırın (`.env` gitignore'da).
# Canlı (live) mod için ZORUNLU; paper modda boş bırakılabilir.

# Binance (USDT-M Futures)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Sadece gerçek işlem (live) modunda kullanılır.
# Testnet için:
# BINANCE_TESTNET=true

# LLM Strateji Danışmanı (provider: api ise)
# LLM_API_KEY=
# LLM_API_URL=
# LLM_API_MODEL=